# any image files
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# Ignore vscode settings
.vscode/
.DS_Store

# second layer of security
/ai-first-nations-data/*
/machine learning/flask-application/uploads/*

# cache files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Generated tree-counter training artifacts
/machine learning/runs/
/screenshots/
/machine learning/yolo11n.pt
/machine learning/tree-counting-model/best_tree_counter.pt
*.cache

# Local drone survey files and preparation cache
/machine learning/Mourilyan_Harbour_Fresh_Test_Images/
/machine learning/evaluations/tree_counter_preparation/

# Generated dataset configs contain local absolute paths
/machine learning/tree-counting-model/evaluation_pack/**/data.yaml
/machine learning/tree-counting-model/mock_dataset/data.yaml

# Temporary evaluation uploads and browser review artifacts
/machine learning/evaluations/tree_counter_hd/**/app_uploads/
/machine learning/evaluations/tree_counter_hd/qa_*.png
/machine learning/evaluations/tree_counter_hd/**/*.log

# Local annotation records and frozen private benchmark manifests
/machine learning/evaluations/new_benchmark/*.sqlite3*
/machine learning/evaluations/new_benchmark/reviewed_manifest.csv
/machine learning/evaluations/new_benchmark/test_lock.json
/machine learning/evaluations/new_benchmark/holdout_review.json
/machine learning/evaluations/new_benchmark/category_mapping.json
